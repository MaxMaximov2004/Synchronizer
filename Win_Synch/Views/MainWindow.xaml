<Window x:Class="Win_Synch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Win_Synch"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="200*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Отслеживаемые еденицы синхронизации">
                <ListBox ItemsSource="{Binding Manage_Units}" SelectedItem="{Binding Selected_Unit, UpdateSourceTrigger=PropertyChanged}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Width="200"/>
                                <Button Command="{Binding Sync}" CommandParameter="{Binding}" Margin="5,0,5,0">Синхронизировать</Button>
                                <Button Command="{Binding DataContext.DeleteUnitCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                        CommandParameter="{Binding}" 
                                        Margin="5,0,5,0" 
                                        Content="Удалить"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </MenuItem>
            <MenuItem Header="Добавить еденицу синхронизации">
                <MenuItem Header="Добавить синхронизируемый файл" />
                <MenuItem Header="Добавить синхронизируемый папку" Command="{Binding Create_Manage_Units}"/>
            </MenuItem>
            <MenuItem Header="DEBUG">
                <MenuItem Header="debug context" Click="MenuItem_Click_1" />
                <MenuItem Header="get errors" Click="MenuItem_Click_2"/>
            </MenuItem>
        </Menu>

        <StackPanel x:Name="WorkField" Grid.Row="1" Orientation="Vertical" Margin="5,5,5,5">
            <Label Content="{Binding Selected_Unit.Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" FontSize="16"/>

            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--
                <Label Grid.Row="0" Grid.Column="0" Content="Тип синхронизации:" FontWeight="Bold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected_Unit.Synch_Manager.GetType().Name, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Тип хранения:" FontWeight="Bold"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected_Unit.Vault_Manager.GetType().Name, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0"/>
                -->
                <ProgressBar 
                    Grid.Row="1"
                    Height="25"
                    Minimum="0" Maximum="{Binding Selected_Unit.Total, UpdateSourceTrigger=PropertyChanged}" Value="{Binding Selected_Unit.Current, UpdateSourceTrigger=PropertyChanged}"> 
                </ProgressBar>
                <Label 
                    Grid.Row="2" 
                    Grid.Column="0" 
                    Content="Количество директорий:" FontSize="16" />
                <TextBlock 
                    Grid.Row="3" 
                    Grid.Column="0" 
                    Text="{Binding Selected_Unit.Data.Count, UpdateSourceTrigger=PropertyChanged}" 
                    FontSize="16"
                    Margin="5,0,0,0"/>
            </Grid>

            <Label Content="Ошибки:" Margin="0,10,0,0"/>
            <ListBox ItemsSource="{Binding Selected_Unit.Synch_Manager.Errors, UpdateSourceTrigger=PropertyChanged}" 
                     Height="100" 
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Margin="5,0,0,0">
            </ListBox>

            <Label Content="Детали синхронизации:" Margin="0,10,0,0"/>
            <ScrollViewer Height="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Selected_Unit.Data, UpdateSourceTrigger=PropertyChanged}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Text="{Binding Source}" Width="auto" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text=" > " Margin="5,0,2,0"/>
                                <TextBlock Text="{Binding Distination}" Width="auto" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        
        </StackPanel>
    </Grid>
</Window>