<Window x:Class="Win_Synch.Views.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Win_Synch.Views"
        mc:Ignorable="d"
        Title="Window1" Height="220" Width="400">
    <Grid>
        <Button Content="Сохранить" HorizontalAlignment="Left" Margin="20,164,0,0" VerticalAlignment="Top" Command="{Binding Save_data}"/>
        <TextBox HorizontalAlignment="Left" Margin="20,54,0,0" TextWrapping="Wrap" Text="{Binding Name}" VerticalAlignment="Top" Width="120"/>
        <TextBox HorizontalAlignment="Left" Margin="20,86,0,0" TextWrapping="Wrap" Text="{Binding Source_Fold}" VerticalAlignment="Top" Width="300"/>
        <TextBox HorizontalAlignment="Left" Margin="20,109,0,0" TextWrapping="Wrap" Text="{Binding Destination_Fold}" VerticalAlignment="Top" Width="300"/>
        <Button Content="select src" HorizontalAlignment="Left" Margin="335,86,0,0" VerticalAlignment="Top" Command="{Binding Select_Source}"/>
        <Button Content="select dst" HorizontalAlignment="Left" Margin="335,108,0,0" VerticalAlignment="Top" Command="{Binding Select_Destination}"/>

    </Grid>
</Window>
